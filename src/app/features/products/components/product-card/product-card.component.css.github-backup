:host {
  display: block;
  height: 100%;
}

/* ==============================
   GRID CARD
   ============================== */

.grid-card {
  background: #fff;
  border-radius: 18px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-shadow: 0 2px 12px rgba(26, 43, 60, 0.05);
  transition: transform 0.28s cubic-bezier(0.25, 0.8, 0.25, 1),
              box-shadow 0.28s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.grid-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 14px 36px rgba(26, 43, 60, 0.1);
}

/* Image area */
.grid-card-img {
  display: block;
  position: relative;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  background: #FAFAFA;
  flex-shrink: 0;
}

.grid-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.45s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.grid-card:hover .grid-card-img img {
  transform: scale(1.05);
}

/* Badges */
.badges-wrap {
  position: absolute;
  top: 10px;
  left: 10px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  z-index: 2;
}

.badge-popular {
  display: inline-block;
  background: #FF6600;
  color: #fff;
  font-size: 0.6rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 4px 10px;
  border-radius: 999px;
}

.badge-stock {
  display: inline-block;
  background: rgba(255, 102, 0, 0.12);
  color: #B45309;
  font-size: 0.6rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 4px 10px;
  border-radius: 999px;
}

.overlay-sold-out {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(3px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.overlay-sold-out span {
  background: #fff;
  color: #1A2B3C;
  font-size: 0.78rem;
  font-weight: 700;
  padding: 6px 18px;
  border-radius: 999px;
  letter-spacing: 0.02em;
}

/* Body */
.grid-card-body {
  padding: 14px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-grow: 1;
}

.card-category {
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: #8896A6;
  margin: 0;
}

.card-title-link {
  text-decoration: none;
}

.card-title {
  font-size: 0.92rem;
  font-weight: 700;
  color: #1A2B3C;
  line-height: 1.35;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color 0.18s;
}

.card-title:hover,
.card-title-link:hover .card-title {
  color: #FF6600;
}

.card-bottom {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-top: 10px;
  border-top: 1px solid #EEF2F6;
}

.card-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.card-price {
  font-size: 1.05rem;
  font-weight: 800;
  color: #1A2B3C;
  margin: 0;
  letter-spacing: -0.01em;
}

.stock-warning-badge {
  font-size: 0.65rem;
  font-weight: 600;
  color: #B45309;
  background: rgba(255, 102, 0, 0.08);
  padding: 3px 8px;
  border-radius: 999px;
  white-space: nowrap;
}

/* Buttons */
.btn-order {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: #FF6600;
  color: #fff;
  font-size: 0.78rem;
  font-weight: 600;
  padding: 10px 16px;
  border-radius: 999px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  white-space: nowrap;
}

.btn-order:hover {
  background: #E65500;
  transform: translateY(-1px);
  box-shadow: 0 5px 14px rgba(255, 102, 0, 0.22);
}

.btn-order-full {
  width: 100%;
}

.btn-unavailable {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.78rem;
  font-weight: 600;
  color: #8896A6;
  background: #FAFAFA;
  padding: 10px 16px;
  border-radius: 999px;
  user-select: none;
}

/* ==============================
   LIST CARD
   ============================== */

.list-card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  gap: 0;
  box-shadow: 0 2px 12px rgba(26, 43, 60, 0.05);
  transition: box-shadow 0.28s ease, transform 0.28s ease;
}

.list-card:hover {
  box-shadow: 0 10px 30px rgba(26, 43, 60, 0.1);
  transform: translateY(-2px);
}

.list-card-img {
  display: block;
  width: 180px;
  min-width: 180px;
  position: relative;
  overflow: hidden;
  background: #FAFAFA;
  flex-shrink: 0;
}

.list-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.list-card:hover .list-card-img img {
  transform: scale(1.04);
}

.list-card-body {
  flex: 1;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160px;
}

.card-desc {
  font-size: 0.82rem;
  color: #8896A6;
  line-height: 1.55;
  margin: 6px 0 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.list-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 12px;
  border-top: 1px solid #EEF2F6;
  margin-top: 12px;
}

.stock-warning {
  font-size: 0.7rem;
  color: #B45309;
  font-weight: 600;
  margin: 3px 0 0;
}

/* Responsive */
@media (max-width: 640px) {
  .list-card {
    flex-direction: column;
  }
  .list-card-img {
    width: 100%;
    min-width: unset;
    height: 200px;
  }
  .list-card-body {
    padding: 14px 16px;
    min-height: unset;
  }
  .list-card-footer {
    flex-wrap: wrap;
  }
}
